# Access Token do Mercado Pago (Produção ou Teste). Sem ele, o checkout responde 503 e o botão mostra aviso amigável.
MERCADOPAGO_ACCESS_TOKEN=

# WhatsApp de SUPORTE (somente dígitos, com código do país e DDD, ex: 5512991070038).
# Usado só para suporte — o acesso ao curso é pela plataforma, nunca pelo WhatsApp.
NEXT_PUBLIC_ADMIN_WHATSAPP=5512991070038

# URL pública do site (utilizada para as back_urls e webhooks do Mercado Pago)
NEXT_PUBLIC_SITE_URL=https://dev-no-bolso.vercel.app

# Upstash Redis (opcional): contadores do funil (sem PII) e registro idempotente de pagamentos aprovados.
# Sem estas variáveis o site funciona normalmente; o analytics só deixa de gravar.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
