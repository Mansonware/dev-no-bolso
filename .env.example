# Access Token do Mercado Pago (Produção ou Teste)
MERCADOPAGO_ACCESS_TOKEN=

# WhatsApp da Administração para receber os alunos (somente números com código do país e DDD, ex: 5512991070038)
NEXT_PUBLIC_ADMIN_WHATSAPP=5512991070038

# URL pública do site (utilizada para as back_urls e webhooks do Mercado Pago)
NEXT_PUBLIC_SITE_URL=https://dev-no-bolso.vercel.app

# Upstash Redis (trava de 10 vagas: fecha o checkout após 10 pagamentos aprovados. Sem Redis, não há trava automática)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
