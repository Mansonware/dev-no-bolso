# Access Token do Mercado Pago (Produção ou Teste)
MERCADOPAGO_ACCESS_TOKEN=

# WhatsApp da Administração para receber os alunos (somente números com código do país e DDD, ex: 5511999999999)
NEXT_PUBLIC_ADMIN_WHATSAPP=5511999999999

# URL pública do site (utilizada para as back_urls e webhooks do Mercado Pago)
# Local: http://localhost:3000
# Produção: https://seu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
